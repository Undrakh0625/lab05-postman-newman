      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('setupStudentID', \"B231234567\");",
              "pm.variables.set('studentStatus', \"active\");",
              "pm.variables.set('coursesTaken', \"[\\\"CS201\\\"]\");",
              "pm.variables.set('setupCourseID', \"CS313\");",
              "pm.variables.set('prerequisites', \"[\\\"CS201\\\"]\");",
              "pm.variables.set('requestBody', \"{\\\"studentID\\\":\\\"B231234567\\\",\\\"courseID\\\":\\\"CS313\\\"}\");",
              "pm.variables.set('expectedStatus', \"201\");",
              "pm.variables.set('expectedResult', \"OK\");"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Setup student",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/students/{{setupStudentID}}",
            "body": {
              "mode": "raw",
              "raw": "{\"status\":\"{{studentStatus}}\",\"coursesTaken\":{{coursesTaken}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Student setup: HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Student setup: result OK', function () { pm.expect(pm.response.json().result).to.eql('OK'); });"
                ]
              }
            }
          ]
        },
